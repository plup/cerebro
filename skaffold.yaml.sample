---
# https://skaffold.dev/docs/references/yaml/
apiVersion: skaffold/v4beta13
kind: Config
metadata:
  name: cerebro
build:
  local:
    push: true
  tagPolicy:
    envTemplate:
      template: test
  artifacts:
    - image: cerebro/server
      platforms:
        - linux/amd64
      context: .
      docker:
        dockerfile: k8s/Dockerfile
    - image: cerebro/worker
      platforms:
        - linux/amd64
      context: ./neuron
      docker:
        dockerfile: Dockerfile
manifests:
  helm:
    releases:
      - name: cerebro-test
        # remoteChart: oci://registry/helm-charts/cerebro
        chartPath: ../../platforms/cerebro-deploy/helm
        # version: 0.1.2
        valuesFiles:
          - k8s/values-test.yaml
        setValueTemplates:
          image.registry: "{{.IMAGE_DOMAIN_cerebro_server}}"
          image.repository: "{{.IMAGE_REPO_NO_DOMAIN_cerebro_server}}"
          image.tag: "{{.IMAGE_TAG_cerebro_server}}@{{.IMAGE_DIGEST_cerebro_server}}"
          workerImage: "{{.IMAGE_FULLY_QUALIFIED_cerebro_worker}}"
